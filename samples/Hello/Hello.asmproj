<Project Sdk="AsmFoundation.Sdk">

  <!--
    Hello: the smallest complete HttpAsm server, and the one the measurements and h2spec runs
    use outside the test process. Every request is answered "Hello, World!" (text/plain), the
    TechEmpower plaintext shape, over HTTP/1.1 and HTTP/2 (h2c with prior knowledge) alike.

    Settings come from the environment, parsed strictly (an invalid value exits 2, never falls
    back to a default): HELLO_PORT (1-65535, default 8080), HELLO_WORKERS (1-1024, default: the
    CPUs this process may run on), HELLO_IO (uring, the default: io_uring where the kernel has
    it; or epoll). It serves until SIGINT or SIGTERM, then stops gracefully.

    TargetFramework libc: glibc for getenv; the server itself comes from libhttpasm.so. AsmSdk
    0.3.0 does not copy a referenced library next to a program, and the program carries no
    RUNPATH, so it runs with LD_LIBRARY_PATH naming src/HttpAsm/bin/<config>/libc/linux-x64
    (benchmarks/run.sh does that).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>libc</TargetFramework>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <AssemblyName>hello</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/HttpAsm/HttpAsm.asmproj" />
  </ItemGroup>

</Project>
