<Project>
  <!--
    Shared settings for every project in HttpAsm: the assembly projects (.asmproj, built with
    AsmFoundation.Sdk, pinned in global.json), the .NET test projects, and the specs/ tool.
    Nothing is released yet (no tags, NuGet pushes or GitHub releases until the owner decides),
    so the version below is a placeholder that no package carries.
  -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>Eli Belash</Authors>
    <Company>AsmFoundation</Company>
    <Copyright>Copyright 2026 Eli Belash</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AsmFoundation/HttpAsm</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AsmFoundation/HttpAsm</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Every NASM warning and every C# warning is an error. The SDK still exempts the two
         relocation warnings that position-independent ELF code always raises. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages/</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UsingAsmFoundationSdk)' == 'true'">
    <!-- Linux x64 only until the protocols are complete (the owner's choice, 2026-11-23): System V
         registers and Linux system calls everywhere. -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <!-- NASM reports file(line): error, which MSBuild counts and IDEs link to the line. -->
    <AsmFlags>-Xvc</AsmFlags>
  </PropertyGroup>

  <!--
    The H1Only configuration (dotnet build -c H1Only) is the isolation measurement's control
    (docs/DESIGN.md, "Sharing between the HTTP versions"): the same sources with HTTP/2's
    detection and dispatch assembled out of the connection loop, so HTTP/1.1 runs exactly the
    code it would if HTTP/2 did not exist. benchmarks/run.sh compares it with the full build;
    nothing ships it.
  -->
  <PropertyGroup Condition="'$(UsingAsmFoundationSdk)' == 'true' and '$(Configuration)' == 'H1Only'">
    <AsmFlags>$(AsmFlags) -DHTTPASM_H1_ONLY</AsmFlags>
  </PropertyGroup>

  <!--
    The Coverage configuration (tests/coverage/run.sh builds it; nothing ships it): the same
    sources, assembled through tests/coverage/instrument.cs, which marks every block and every
    branch edge, with tests/coverage/coverage_rt.asm linked into libhttpasm.so to write the marks
    out when a process exits. The SDK's System toolchain lets the build name its own commands;
    run.sh resolves the SDK's bundled NASM, lld and llvm-ar and passes their paths in the
    environment, because the NuGet paths are not known yet when this file is evaluated.
  -->
  <PropertyGroup Condition="'$(UsingAsmFoundationSdk)' == 'true' and '$(Configuration)' == 'Coverage'">
    <AsmToolchain>System</AsmToolchain>
    <AsmNasmCommand>dotnet run --file "$(MSBuildThisFileDirectory)tests/coverage/instrument.cs" -- --nasm "$(HTTPASM_COVERAGE_NASM)"</AsmNasmCommand>
    <AsmLinkerCommand>"$(HTTPASM_COVERAGE_LLD)" -flavor gnu</AsmLinkerCommand>
    <AsmArchiverCommand>"$(HTTPASM_COVERAGE_AR)"</AsmArchiverCommand>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsingAsmFoundationSdk)' == 'true' and '$(Configuration)' == 'Coverage' and '$(MSBuildProjectName)' == 'HttpAsm'">
    <AsmSource Include="$(MSBuildThisFileDirectory)tests/coverage/coverage_rt.asm" />
  </ItemGroup>

  <!--
    The Fuzz configuration (tests/fuzz/run.sh builds it; nothing ships it): the Coverage
    configuration's markers, put in libFuzzer's "__libfuzzer_extra_counters" section instead.
    libFuzzer reads every octet of that section as a coverage counter of its own, so a fuzzer
    linked with these objects steers by the assembly's blocks and branch edges. No coverage_rt:
    libFuzzer reads (and clears) the counters itself.
  -->
  <PropertyGroup Condition="'$(UsingAsmFoundationSdk)' == 'true' and '$(Configuration)' == 'Fuzz'">
    <AsmToolchain>System</AsmToolchain>
    <AsmNasmCommand>dotnet run --file "$(MSBuildThisFileDirectory)tests/coverage/instrument.cs" -- --section __libfuzzer_extra_counters --nasm "$(HTTPASM_COVERAGE_NASM)"</AsmNasmCommand>
    <AsmLinkerCommand>"$(HTTPASM_COVERAGE_LLD)" -flavor gnu</AsmLinkerCommand>
    <AsmArchiverCommand>"$(HTTPASM_COVERAGE_AR)"</AsmArchiverCommand>
  </PropertyGroup>
</Project>
