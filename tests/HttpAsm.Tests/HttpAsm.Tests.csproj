<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HttpAsm's tests: libhttpasm.so's C ABI called from .NET, each test naming the requirement
    rows of specs/requirements.tsv that it proves ([Requirement]).

    Linux x64 only (libhttpasm.so is an ELF file): elsewhere the native tests are skipped with
    the reason, unless HTTPASM_REQUIRE_LINUX=1 (CI, tests/run-linux.sh) turns that into a
    failure. The registry tests are plain .NET and run everywhere. On Windows, run them all in a
    Linux container: tests/run-linux.sh.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xunit.v3 test projects are self-hosting executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The tests pass pointers into pinned and guarded buffers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>HttpAsm.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- xunit.v3 4.x adds no implicit using for its namespace; one global using serves every file. -->
    <Using Include="Xunit" />
    <!-- Kestrel, the independent server the C ABI's client is tested against (ClientTests). The
         runners need the ASP.NET Core shared framework: run-linux.sh's container is the aspnet
         image, WSL's ~/.dotnet has it, CI's SDK does. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- libhttpasm.so, delivered by AsmFoundation.Sdk to runtimes/linux-x64/native/. -->
    <ProjectReference Include="../../src/HttpAsm/HttpAsm.asmproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The registry travels with the tests, so a container that only has the output folder
         (tests/run-linux.sh) can check every [Requirement] id against it. -->
    <None Include="../../specs/requirements.tsv" Link="specs/requirements.tsv" CopyToOutputDirectory="PreserveNewest" />
    <!-- The deferrals: what M1 does not prove, and why (RegistryTests.AccountsForEveryM1Row). -->
    <None Include="../../specs/deferred.tsv" Link="specs/deferred.tsv" CopyToOutputDirectory="PreserveNewest" />
    <!-- RFC 7541 itself: the HPACK tests read Appendix C's examples from the pinned file. -->
    <None Include="../../specs/rfc/rfc7541.txt" Link="specs/rfc/rfc7541.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- RFC 8439 itself: the ChaCha20-Poly1305 tests read its test vectors (section 2.8.2 and
         Appendix A) from the pinned file, so no octet of them is copied by hand. -->
    <None Include="../../specs/rfc/rfc8439.txt" Link="specs/rfc/rfc8439.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- RFC 7748 itself: the X25519 tests read section 5.2's and 6.1's vectors from it. -->
    <None Include="../../specs/rfc/rfc7748.txt" Link="specs/rfc/rfc7748.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- RFC 6979 itself: the P-256 tests read A.2.5's key pair and signatures from it. -->
    <None Include="../../specs/rfc/rfc6979.txt" Link="specs/rfc/rfc6979.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- RFC 8017 itself: the RSA tests read 9.2's DigestInfo prefixes from it. -->
    <None Include="../../specs/rfc/rfc8017.txt" Link="specs/rfc/rfc8017.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
