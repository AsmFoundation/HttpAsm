# h1_request.dict - libFuzzer's dictionary for tests/fuzz/h1_request.c (run.sh passes
# -dict= when tests/fuzz/<name>.dict exists).
#
# Why a dictionary: the parser is assembly, so libFuzzer sees its blocks and branch edges (the
# extra counters) but not the values it compares against - there is no -fsanitize-coverage=
# trace-cmp for NASM code. Without these words, reaching "Transfer-Encoding: chunked" by single
# octet mutations takes millions of tries; with them, one insertion. Each entry is a word the
# request parser (src/HttpAsm.Core/h1/request.asm) or the field lookup compares against, or a
# separator its grammar turns on (RFC 9112 sections 2-6, RFC 9110 sections 5 and 7).

# Separators and line ends: CRLF, the bare LF the parser refuses, OWS, obs-fold's leading SP.
"\x0d\x0a"
"\x0d\x0a\x0d\x0a"
"\x0a"
": "
":"
" "
"\x09"
"\x0d\x0a "

# Methods (RFC 9110 9.3, RFC 5789) and versions (RFC 9112 2.3).
"GET"
"HEAD"
"POST"
"PUT"
"DELETE"
"CONNECT"
"OPTIONS"
"TRACE"
"PATCH"
"HTTP/1.1"
"HTTP/1.0"
"HTTP/2.0"
"HTTP/0.9"
"HTTP/1.10"

# Request targets (RFC 9112 3.2): origin, absolute, authority and asterisk forms, and the
# octets that change a URI's parse.
"/"
"*"
"http://"
"https://"
"example.com"
"example.com:443"
"[::1]:8080"
"user@host"
"%2F"
"%"
"?"
"#"
"//"

# Framing values (RFC 9112 6-7, RFC 9110 10.1.1).
"chunked"
"gzip, chunked"
"chunked, gzip"
"identity"
"close"
"keep-alive"
"100-continue"
"trailers"
"h2c"
"0"
"18446744073709551615"
"18446744073709551616"
"00000000000000000001"

# Every field name the library knows (httpasm_fields.h, generated): the lookup's hits.
"accept-charset"
"accept-encoding"
"accept-language"
"accept-ranges"
"accept"
"access-control-allow-origin"
"age"
"allow"
"authorization"
"cache-control"
"content-disposition"
"content-encoding"
"content-language"
"Content-Length"
"content-length"
"content-location"
"content-range"
"content-type"
"cookie"
"date"
"etag"
"Expect"
"expect"
"expires"
"from"
"Host"
"host"
"if-match"
"if-modified-since"
"if-none-match"
"if-range"
"if-unmodified-since"
"last-modified"
"link"
"location"
"max-forwards"
"proxy-authenticate"
"proxy-authorization"
"range"
"referer"
"refresh"
"retry-after"
"server"
"set-cookie"
"strict-transport-security"
"Transfer-Encoding"
"transfer-encoding"
"user-agent"
"vary"
"via"
"www-authenticate"
"access-control-allow-headers"
"x-content-type-options"
"x-xss-protection"
"access-control-allow-credentials"
"access-control-allow-methods"
"access-control-expose-headers"
"access-control-request-headers"
"access-control-request-method"
"alt-svc"
"content-security-policy"
"early-data"
"expect-ct"
"forwarded"
"origin"
"purpose"
"timing-allow-origin"
"upgrade-insecure-requests"
"x-forwarded-for"
"x-frame-options"
"Connection"
"connection"
"keep-alive"
"proxy-connection"
"TE"
"te"
"trailer"
"Upgrade"
"upgrade"
"HTTP2-Settings"
