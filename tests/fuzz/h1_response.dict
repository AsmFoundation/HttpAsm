# h1_response.dict - libFuzzer's dictionary for tests/fuzz/h1_response.c (run.sh passes
# -dict= when tests/fuzz/<name>.dict exists).
#
# Why a dictionary: libFuzzer sees the assembly's blocks and branch edges but not the values it
# compares against (no trace-cmp for NASM code). Each entry is a word the response parser
# (src/HttpAsm.Core/h1/response.asm) or the shared field-line code compares against, or a
# separator its grammar turns on (RFC 9112 sections 4-6, RFC 9110 section 15).

# Separators and line ends: CRLF, the bare LF the parser refuses, OWS, obs-fold's leading SP.
"\x0d\x0a"
"\x0d\x0a\x0d\x0a"
"\x0a"
": "
":"
" "
"\x09"
"\x0d\x0a "
"\x0d\x0a\x09"

# Versions (RFC 9112 2.3): 1.x minors are read as 1.1, other majors refused.
"HTTP/1.1"
"HTTP/1.0"
"HTTP/1.9"
"HTTP/2.0"
"HTTP/0.9"

# Status codes whose framing differs (RFC 9112 6.3): interim, no content, not modified,
# successful (a tunnel after CONNECT), and codes outside 100-599.
" 100 "
" 101 "
" 199 "
" 200 "
" 204 "
" 299 "
" 300 "
" 304 "
" 404 "
" 599 "
" 600 "
" 000 "
" 099 "

# Framing values (RFC 9112 6-7, 9.3).
"chunked"
"gzip, chunked"
"chunked, gzip"
"gzip"
"identity"
"close"
"keep-alive"
"0"
"18446744073709551615"
"18446744073709551616"
"1, 1"
"1,2"

# Every field name the library knows (httpasm_fields.h, generated): the lookup's hits.
"accept-charset"
"accept-encoding"
"accept-language"
"accept-ranges"
"accept"
"access-control-allow-origin"
"age"
"allow"
"authorization"
"cache-control"
"content-disposition"
"content-encoding"
"content-language"
"Content-Length"
"content-length"
"content-location"
"content-range"
"content-type"
"cookie"
"date"
"etag"
"Expect"
"expect"
"expires"
"from"
"Host"
"host"
"if-match"
"if-modified-since"
"if-none-match"
"if-range"
"if-unmodified-since"
"last-modified"
"link"
"location"
"max-forwards"
"proxy-authenticate"
"proxy-authorization"
"range"
"referer"
"refresh"
"retry-after"
"server"
"set-cookie"
"strict-transport-security"
"Transfer-Encoding"
"transfer-encoding"
"user-agent"
"vary"
"via"
"www-authenticate"
"access-control-allow-headers"
"x-content-type-options"
"x-xss-protection"
"access-control-allow-credentials"
"access-control-allow-methods"
"access-control-expose-headers"
"access-control-request-headers"
"access-control-request-method"
"alt-svc"
"content-security-policy"
"early-data"
"expect-ct"
"forwarded"
"origin"
